# Copy this file to .env.local and provide real values through a secure channel.
DATABASE_URL=
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=
INVITATION_PUBLIC_URL=http://localhost:3000

# Required only when sending real transactional email.
GMAIL_SMTP_USER=
GMAIL_SMTP_APP_PASSWORD=
GMAIL_SMTP_FROM=

# Required for private file storage and upload regression checks.
TIGRIS_BUCKET=
TIGRIS_ACCESS_KEY_ID=
TIGRIS_SECRET_ACCESS_KEY=
TIGRIS_ENDPOINT=https://t3.storage.dev
